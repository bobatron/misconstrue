# misconstrue settings
# Copy this file to .env and uncomment any line to change it, then restart (make dev).
# Environment variables with the same name override .env.
# Check what's in use with: make settings

# ────────────────────────────────────────────────────────────────────────────
# Masking: how the disguise sentence is made
# ────────────────────────────────────────────────────────────────────────────

# Which AI writes natural phrases around the carrier words. 'none' = plain word lists.
# LLM_PROVIDER=ollama

# Ollama model to use (must be pulled: `ollama pull <name>`).
# OLLAMA_MODEL=qwen3:8b

# Phrases the AI suggests per group; the shortest valid one is used. More = better odds,
# slower. [min 1, max 20]
# LLM_CANDIDATES=6

# Carrier-word groups the AI must fit into one phrase. Small models manage 2-3. [min 1,
# max 6]
# LLM_GROUPS_PER_PHRASE=3

# How common a carrier word must be (Zipf scale: 3 = uncommon, 4 = everyday, 5 = very
# common). Higher = easier words to read, but fewer choices and more cuts. [min 1.0, max
# 7.0]
# MIN_CARRIER_ZIPF=3.5

# Carrier words may not contain a target word of this many letters or more (stops
# 'originally' hiding inside a carrier). [min 2, max 12]
# CONTAINED_WORD_MIN_LETTERS=4

# Carrier words sharing this many letters in a row with a target word are rejected
# ('aboriginal' vs 'originally'). Higher = less secret, more choices. [min 3, max 20]
# SHARED_LETTERS_LIMIT=6

# Pronunciations likelier than this must ALL contain a carrier's sounds, so it doesn't
# matter which way the reader says the word. Lower = safer, fewer choices. [min 0.0, max
# 1.0]
# MIN_VARIANT_PROB=0.3

# ────────────────────────────────────────────────────────────────────────────
# Retake check: how strict we are about reading the whole sentence
# ────────────────────────────────────────────────────────────────────────────

# Largest share of masked-sentence words that may be missed or misheard (0.5 = half).
# Words the edit needs must always be there. Lower = stricter. [min 0.0, max 1.0]
# MAX_WER=0.5

# How much of a word's sounds must be heard to count a near-miss as said ('forward' for
# 'forehead'). Higher = stricter. [min 0.0, max 1.0]
# FUZZY_MATCH_RATIO=0.6

# Needed words whose sounds average shorter than this (ms) are treated as not really said
# (mumbled or skipped). Higher = stricter. [min 0, max 200]
# MIN_CRITICAL_PHONE_MS=35

# How far (seconds) the aligner and the transcriber may disagree about when a needed word
# was said. Lower = stricter. [min 0.05, max 5.0]
# MAX_WORD_TIME_DRIFT_S=0.6

# After this many attempts, make the best video we can instead of asking again. [min 1,
# max 50]
# MAX_RETAKES=5

# ────────────────────────────────────────────────────────────────────────────
# Output video
# ────────────────────────────────────────────────────────────────────────────

# Overlap between stitched sound pieces (ms). Longer = smoother but blurrier. [min 0, max
# 50]
# CROSSFADE_MS=8

# How far (ms) each cut may move to land on a quieter moment. [min 0, max 50]
# SNAP_WINDOW_MS=15

# Silent footage before and after the sentence (seconds). [min 0.0, max 3.0]
# LEAD_IN_S=0.3

# Output video height in pixels. [min 144, max 1080]
# OUTPUT_HEIGHT=480

# Output frames per second. [min 10, max 60]
# FPS=30

# Output audio sample rate (Hz). [min 16000, max 96000]
# AUDIO_SR=48000

# ────────────────────────────────────────────────────────────────────────────
# Limits
# ────────────────────────────────────────────────────────────────────────────

# Longest sentence User 1 may enter (words). [min 1, max 100]
# MAX_TARGET_WORDS=25

# Largest recording upload (MB). [min 1, max 2000]
# MAX_UPLOAD_MB=100

# ────────────────────────────────────────────────────────────────────────────
# Models, paths & services (advanced)
# ────────────────────────────────────────────────────────────────────────────

# Where Ollama is listening.
# OLLAMA_URL=http://localhost:11434

# Whisper model for the retake check (tiny.en, base.en, small.en, medium.en).
# WHISPER_MODEL=small.en

# Montreal Forced Aligner acoustic model.
# MFA_ACOUSTIC_MODEL=english_us_arpa

# Montreal Forced Aligner pronunciation dictionary.
# MFA_DICTIONARY=english_us_arpa

# Where MFA keeps its models.
# MFA_ROOT_DIR=~/Documents/MFA

# Dictionary file to plan with. Default: the MFA dictionary above, so planning and
# alignment always agree.
# PRONUNCIATION_DICT=

# Where recordings, videos and the database are stored.
# DATA_DIR=./data
